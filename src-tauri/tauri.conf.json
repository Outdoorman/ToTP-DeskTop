{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TOTP Desk",
  "version": "0.1.5",
  "identifier": "app.totpdesk.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "TOTP Desk",
        "width": 500,
        "height": 820,
        "minWidth": 420,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "轻量、安全的离线 TOTP 验证器",
    "longDescription": "TOTP Desk 是使用 Rust 和 Tauri 构建的 Windows 离线 TOTP 验证器。"
  }
}
